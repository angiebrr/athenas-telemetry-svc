{
  "folders": [
    {
      "name": "ROOT",
      "path": "../",
    },
    {
      "name": "GO: Telemetry Svc",
      "path": "../athenas-telemetry-svc"
    },
    {
      "name": "GO: Acceptance Tests",
      "path": "../athenas-acceptance-tests"
    },
  ],
  "settings": {
    "files.exclude": {
      "**/athenas-telemetry-svc": true,
      "**/athenas-acceptance-tests": true,
    },
    "go.lintTool": "golangci-lint-v2",
    // Resolve tools by name through mise's shims so the editor runs the versions mise pins, instead
    // of copies the Go extension installs into GOBIN on its own.
    "go.alternateTools": {
      "golangci-lint-v2": "golangci-lint",
      "gopls": "gopls",
      "dlv": "dlv",
    },
    "go.toolsManagement.checkForUpdates": "off",
    "go.inlayHints.constantValues": true,
    "go.inlayHints.rangeVariableTypes": true,
    "go.lintOnSave": "workspace",
  }
}
